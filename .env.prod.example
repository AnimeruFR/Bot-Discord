# Environnement de PRODUCTION. Copie ce fichier en .env.prod sur le serveur d'hébergement uniquement,
# puis : chmod 600 .env.prod. Lancement : npm run prod (ou docker compose up -d, qui lit ce fichier).

DISCORD_TOKEN=

DATABASE_PATH=data/bot.db

# (Optionnel) Rôle staff par défaut des tickets (chaque serveur peut choisir le sien avec /setticket)
TICKET_STAFF_ROLE_ID=

# Sauvegarde automatique de la base toutes les N heures (0 = désactivée), dans BACKUP_DIR, en gardant les BACKUP_KEEP dernières
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=backups
BACKUP_KEEP=7

# (Optionnel) Liens https affichés par /invite et /about : serveur de support, conditions d'utilisation, confidentialité
SUPPORT_URL=
TERMS_URL=
PRIVACY_URL=

# (Optionnel) Premium : ID du SKU « abonnement serveur » (Developer Portal > Monetization). Vide = tout est gratuit
PREMIUM_SKU_ID=
# (Optionnel) Serveurs qui ont le premium gratuitement, ID séparés par des virgules
PREMIUM_GUILD_IDS=

# (Optionnel) Tableau de bord web (npm run dashboard) : Developer Portal > OAuth2 > Client Secret,
# et ajoute ${DASHBOARD_URL}/callback dans OAuth2 > Redirects. En prod, DASHBOARD_URL en https.
DISCORD_CLIENT_SECRET=
DASHBOARD_URL=https://bot.exemple.fr
DASHBOARD_PORT=3000
# 1 seulement derrière un reverse proxy (lit l'IP dans X-Forwarded-For)
DASHBOARD_TRUST_PROXY=1

# Interrupteur d'urgence (facultatif) : coupe des fonctions sur tous les serveurs, sans redéployer (redémarrage seulement).
# Ex. : DESACTIVER=communaute.jeux,commande:quiz  (le module Général ne se coupe jamais)
DESACTIVER=

# Sel secret du mot du jour et de l'énigme du jour (facultatif). Sans cette ligne, un sel aléatoire est créé dans sel-jeux.txt à côté de la base.
# JEUX_SEL=
