{
  "name": "bot-discord",
  "version": "1.3.0",
  "private": true,
  "description": "Bot Discord de mod\u00e9ration et de tickets",
  "main": "main.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning main.js",
    "dev": "node --disable-warning=ExperimentalWarning main.js --env=dev",
    "prod": "node --disable-warning=ExperimentalWarning main.js --env=prod",
    "deploy": "node --disable-warning=ExperimentalWarning scripts/deploy.js",
    "deploy:dev": "node --disable-warning=ExperimentalWarning scripts/deploy.js --env=dev",
    "deploy:prod": "node --disable-warning=ExperimentalWarning scripts/deploy.js --env=prod",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.js",
    "lint": "eslint .",
    "check": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.js\"",
    "couverture": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "test": "npm run lint && npm run check",
    "invite": "node --disable-warning=ExperimentalWarning scripts/invite.js",
    "premium:test": "node --disable-warning=ExperimentalWarning scripts/premium-test.js",
    "dashboard": "node --disable-warning=ExperimentalWarning dashboard/index.js",
    "dashboard:dev": "node --disable-warning=ExperimentalWarning dashboard/index.js --env=dev"
  },
  "engines": {
    "node": ">=22.13"
  },
  "author": "Animeru",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.28.1",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
