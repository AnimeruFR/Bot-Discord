# Environnement de DÉVELOPPEMENT. Copie ce fichier en .env.dev, puis lance : npm run dev
# Utilise le token de la 2e application Discord « Bot-Discord DEV », jamais celui de la prod.

DISCORD_TOKEN=

# Base séparée de la prod
DATABASE_PATH=data/dev.db

# (Optionnel) ID du rôle staff des tickets sur ton serveur de test
TICKET_STAFF_ROLE_ID=

# Sauvegardes automatiques : inutiles en dev (0 = désactivées)
BACKUP_INTERVAL_HOURS=0

# (Optionnel) Liens https affichés par /invite et /about : serveur de support, conditions d'utilisation, confidentialité
SUPPORT_URL=
TERMS_URL=
PRIVACY_URL=
