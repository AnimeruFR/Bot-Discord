# Copie ce fichier en .env puis remplis les valeurs. Ne commite jamais .env !

# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# (Optionnel) ID du rôle staff qui voit et gère les tickets
TICKET_STAFF_ROLE_ID=

# (Optionnel) Emplacement de la base SQLite (par défaut : data/bot.db)
DATABASE_PATH=

# (Optionnel) Liens https affichés par /invite et /about : serveur de support, conditions d'utilisation, confidentialité
SUPPORT_URL=
TERMS_URL=
PRIVACY_URL=
